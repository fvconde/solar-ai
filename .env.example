# Copie para .env e preencha. O .env esta no .gitignore.
# Chave criada no Google AI Studio, em projeto Google Cloud ISOLADO e SEM billing.
# Ativar billing no projeto apaga o free tier dele inteiro, de forma irreversivel.
GEMINI_API_KEY=

# Modelo FIXO, nunca um alias. 'gemini-flash-lite-latest' e ponteiro movel:
# o Google troca o modelo por tras dele sem aviso, e o comportamento dos
# prompts da Lia muda sozinho -- risco inaceitavel com entrega marcada.
# Fallback se a cota do 3.5 apertar: gemini-2.5-flash-lite
GEMINI_MODEL=gemini-3.5-flash-lite

# Opcional e sem efeito em gemini-3.5-flash-lite, que tem sampling fixo.
# Vale so para o fallback gemini-2.5-flash-lite. Vazio = nao enviar.
GEMINI_TEMPERATURE=
